{
  "name": "@vocaverse/practice-studio",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "build:cf": "node build-cf.mjs",
    "dev": "node build.mjs && node server.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"api/**/*.mjs\" \"test/**/*.mjs\" server.mjs build-cf.mjs worker.mjs",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"api/**/*.mjs\" \"test/**/*.mjs\" server.mjs build-cf.mjs worker.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "autoprefixer": "^10.4.23",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "postcss": "^8.5.6",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.19"
  }
}
