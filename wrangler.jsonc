// Cloudflare Workers (Workers Builds từ GitHub): tự build bản web SPA + học liệu công khai rồi phục vụ qua Worker Edge API & Assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vocapiano-ai-studio",
  "main": "apps/web/worker.mjs",
  "compatibility_date": "2026-11-01",
  "build": {
    "command": "cd apps/web && npm ci && npm run build:cf"
  },
  "assets": {
    "directory": "./apps/web/dist-cf",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/robots.txt", "/sitemap.xml"]
  }
}
